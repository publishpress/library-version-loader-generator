#!/usr/bin/env php
<?php

echo "Generating version loader files...\n";

$binDir = $_composer_bin_dir ?? __DIR__ . '/../../vendor/bin';
$projectPath = dirname($binDir, 2);


// Get current version from composer.json (root "version", or "extra.version" if omitted)
$composerJson = file_get_contents($projectPath . '/composer.json');
$composerData = json_decode($composerJson, true);
$version = null;
if (isset($composerData['version']) && $composerData['version'] !== '') {
    $version = $composerData['version'];
} elseif (isset($composerData['extra']['version']) && $composerData['extra']['version'] !== '') {
    $version = $composerData['extra']['version'];
} elseif (isset($composerData['extra']['generator']['version']) && $composerData['extra']['generator']['version'] !== '') {
    $version = $composerData['extra']['generator']['version'];
}
if ($version === null) {
    fwrite(STDERR, "composer.json must define a non-empty \"version\" property or \"extra.version\" or \"extra.generator.version\".\n");
    exit(1);
}
$name = $composerData['name'];
$extra = $composerData['extra']['generator'];
$srcDir = $extra['src-dir'] ?? 'lib';
$actionInitializingPriority = $extra['action-initialize-priority'] ?? '-190';
$actionRegisteringPriority = $extra['action-register-priority'] ?? '-200';
$generateTestFile = $extra['generate-test-file'] ?? true;
$testFileRelative = $extra['test-file'] ?? 'tests/codeception/Integration/VersionLoaderCest.php';

// Convert the $name to a valid PHP namespace using camel case
$namespace = $extra['namespace'] ?? null;
if (empty($namespace)) {
    $namespace = str_replace('-', '', ucwords($name, '-/\\'));
    $namespace = str_replace('/', '\\', $namespace);
    $namespace = str_replace('Publishpress', 'PublishPress', $namespace);
}

$versionStrForFunction = str_replace('.', 'Dot', $version);

preg_match('/(alpha|beta|rc)/', $version, $matches);
$isPreRelease = !empty($matches);
if ($isPreRelease) {
    $versionStrForFunction = str_replace($matches[0], ucfirst($matches[0]), $versionStrForFunction);
}

$versionStrForFunction = str_replace('-', 'Dash', $versionStrForFunction);

$classTest = $extra['lib-class-test'];

$actionPrefix = preg_replace_callback(
    '/([A-Z])/',
    function ($matches) {
        return '_' . strtolower($matches[1]);
    },
    $namespace
);
$actionPrefix = str_replace('\\', '', $actionPrefix);
$actionPrefix = str_replace('publish_press', 'publishpress', $actionPrefix);
$actionPrefix = ltrim($actionPrefix, '_');

function generateIncludeFile(
    $namespace,
    $version,
    $versionStrForFunction,
    $classTest,
    $actionPrefix,
    $projectPath,
    $srcDir,
    $actionInitializingPriority,
    $actionRegisteringPriority
) {
    $includeFile = $projectPath . '/' . $srcDir . '/include.php';

    if (file_exists($includeFile)) {
        unlink($includeFile);
    }

    echo "Generating file {$srcDir}/include.php\n";

    $constantNamePrefix = preg_replace_callback(
        '/([A-Z])/',
        function ($matches) {
            return '_' . $matches[1];
        },
        $namespace
    );
    $constantNamePrefix = ltrim($constantNamePrefix, '_');

    $constantNamePrefix = strtoupper(str_replace('\\', '_', $constantNamePrefix));
    $constantNamePrefix = str_replace('__', '_', $constantNamePrefix);
    $constantNamePrefix = str_replace('PUBLISH_PRESS', 'PUBLISHPRESS', $constantNamePrefix);

    $versionConstantName = $constantNamePrefix . '_VERSION';
    $includedConstantName = $constantNamePrefix . '_INCLUDED';

    // Create the include.php file
    $template = <<<TEMPLATE
/********************************************************************************
 * This file was automatically generated by the version-loader-generator script
 * whenever the composer update command is run.
 *
 * WARNING: Do not modify this file directly. Your changes will be overwritten.
 *******************************************************************************/

namespace {$namespace};

use function add_action;
use function do_action;

if (! function_exists('add_action')) {
    return;
}

if (! function_exists(__NAMESPACE__ . '\\register{$versionStrForFunction}')) {
    if (! defined('{$includedConstantName}')) {
        define('{$includedConstantName}', __DIR__);
    }

    if (! class_exists('{$namespace}\\VersionLoader')) {
        require_once __DIR__ . '/VersionLoader.php';

        add_action('plugins_loaded', [VersionLoader::class, 'initializeLatestVersion'], {$actionInitializingPriority}, 0);
    }

    add_action('plugins_loaded', __NAMESPACE__ . '\\register{$versionStrForFunction}', {$actionRegisteringPriority}, 0);

    function register{$versionStrForFunction}()
    {
        if (! {$classTest}) {
            \$loader = VersionLoader::getInstance();
            \$loader->register('{$version}', __NAMESPACE__ . '\\initialize{$versionStrForFunction}');
        }
    }

    function initialize{$versionStrForFunction}()
    {
        require_once __DIR__ . '/autoload.php';

        if (! defined('{$versionConstantName}')) {
            define('{$versionConstantName}', '{$version}');
        }

        do_action('{$actionPrefix}_{$versionStrForFunction}_initialized');
    }
}

TEMPLATE;

    $fileContent = "<?php\n\n" . $template;

    file_put_contents($projectPath . '/' . $srcDir . '/include.php', $fileContent);
}

function generateVersionClassFile($namespace, $version, $versionStrForFunction, $projectPath, $srcDir)
{
    $versionClassFile = $projectPath . '/' . $srcDir . '/VersionLoader.php';

    $legacyClassFile = $projectPath . '/' . $srcDir . '/Versions.php';
    if (file_exists($legacyClassFile)) {
        unlink($legacyClassFile);
    }

    if (file_exists($versionClassFile)) {
        unlink($versionClassFile);
    }

    echo "Generating file {$srcDir}/VersionLoader.php\n";

    $namespaceStr = str_replace('\\', '\\\\', $namespace);

    $template = <<<TEMPLATE
/********************************************************************************
 * This file was automatically generated by the version-loader-generator script
 * whenever the composer update command is run.
 *
 * WARNING: Do not modify this file directly. Your changes will be overwritten.
 *******************************************************************************/

namespace {$namespace};

if (! class_exists('{$namespaceStr}\\\\VersionLoader')) {
    /**
     * Newest-wins loader for this prefixed library (same idea as ActionScheduler_Versions).
     */
    class VersionLoader
    {
        /**
         * @var VersionLoader
         */
        private static \$instance = null;

        private \$versions = array();

        public function register(\$versionString, \$initializationCallback): bool
        {
            if (isset(\$this->versions[\$versionString])) {
                return false;
            }

            \$this->versions[\$versionString] = \$initializationCallback;

            return true;
        }

        public function getVersions(): array
        {
            return \$this->versions;
        }

        public function latestVersion()
        {
            \$keys = array_keys(\$this->versions);
            if (empty(\$keys)) {
                return false;
            }
            uasort(\$keys, 'version_compare');
            return end(\$keys);
        }

        public function latestVersionCallback()
        {
            \$latest = \$this->latestVersion();
            if (empty(\$latest) || ! isset(\$this->versions[\$latest])) {
                return '__return_null';
            }

            return \$this->versions[\$latest];
        }

        /**
         * @return VersionLoader
         * @codeCoverageIgnore
         */
        public static function getInstance(): ?VersionLoader
        {
            if (empty(self::\$instance)) {
                self::\$instance = new self();
            }

            return self::\$instance;
        }

        /**
         * @codeCoverageIgnore
         */
        public static function initializeLatestVersion(): void
        {
            \$self = self::getInstance();

            call_user_func(\$self->latestVersionCallback());
        }
    }
}

TEMPLATE;
    $fileContent = "<?php\n\n" . $template;

    file_put_contents($versionClassFile, $fileContent);
}

function generateTestFile($namespace, $version, $versionStrForFunction, $classTest, $actionPrefix, $projectPath, $testFileRelative)
{
    $testFile = $projectPath . '/' . ltrim($testFileRelative, '/');
    $testDir = dirname($testFile);

    if (! is_dir($testDir) && ! mkdir($testDir, 0755, true) && ! is_dir($testDir)) {
        fwrite(STDERR, "Failed to create directory {$testDir}\n");
        exit(1);
    }

    if (file_exists($testFile)) {
        unlink($testFile);
    }

    echo "Generating file {$testFileRelative}\n";

    $template = <<<TEMPLATE
/********************************************************************************
 * This file was automatically generated by the version-loader-generator script
 * whenever the composer update command is run.
 *
 * WARNING: Do not modify this file directly. Your changes will be overwritten.
 *******************************************************************************/

use {$namespace}\VersionLoader;

class VersionLoaderCest
{
    public function testAllVersionsAreRegistered(IntegrationTester \$I)
    {
        \$loader = VersionLoader::getInstance();

        \$registeredVersions = \$loader->getVersions();

        \$I->assertNotEmpty(\$registeredVersions);
        \$I->assertEquals([
            '2.0.0.1' => '{$namespace}\initialize2Dot0Dot0Dot1',
            '2.0.0.2' => '{$namespace}\initialize2Dot0Dot0Dot2',
            '{$version}' => '{$namespace}\initialize{$versionStrForFunction}',
        ], \$registeredVersions);
    }

    public function testLatestVersionIsTheCurrentVersion(IntegrationTester \$I)
    {
        \$loader = VersionLoader::getInstance();

        \$latestVersion = \$loader->latestVersion();

        \$I->assertEquals('{$version}', \$latestVersion);
    }

    public function testLatestVersionCallbackIsTheLastOne(IntegrationTester \$I)
    {
        \$loader = VersionLoader::getInstance();

        \$latestVersionCallback = \$loader->latestVersionCallback();

        \$I->assertEquals('{$namespace}\\initialize{$versionStrForFunction}', \$latestVersionCallback);
    }

    public function testInitializeLatestVersion(IntegrationTester \$I)
    {
        \$loader = VersionLoader::getInstance();

        \$loader->initializeLatestVersion();

        \$I->assertTrue({$classTest});

        \$didAction = (bool)did_action('{$actionPrefix}_{$versionStrForFunction}_initialized');
        \$I->assertTrue(\$didAction);
    }
}

TEMPLATE;

    $fileContent = "<?php\n\n" . $template;

    file_put_contents($testFile, $fileContent);
}

generateIncludeFile(
    $namespace,
    $version,
    $versionStrForFunction,
    $classTest,
    $actionPrefix,
    $projectPath,
    $srcDir,
    $actionInitializingPriority,
    $actionRegisteringPriority
);

generateVersionClassFile(
    $namespace,
    $version,
    $versionStrForFunction,
    $projectPath,
    $srcDir
);

$legacyTestFiles = [
    $projectPath . '/tests/wpunit/VersionsCest.php',
    $projectPath . '/tests/codeception/Integration/VersionsCest.php',
];
$generatedTestFile = $projectPath . '/' . ltrim($testFileRelative, '/');
foreach ($legacyTestFiles as $legacyTestFile) {
    if (file_exists($legacyTestFile) && realpath($legacyTestFile) !== realpath($generatedTestFile)) {
        unlink($legacyTestFile);
    }
}

if ($generateTestFile) {
    generateTestFile(
        $namespace,
        $version,
        $versionStrForFunction,
        $classTest,
        $actionPrefix,
        $projectPath,
        $testFileRelative
    );
}

echo "VersionLoader files generated successfully\n";
